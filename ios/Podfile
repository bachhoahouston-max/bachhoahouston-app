# react-native-vision-camera: only the native code scanner is used (no JS frame
# processors), so skip the FrameProcessors subspec / react-native-worklets-core.
$VCEnableFrameProcessors = false

# Resolve react_native_pods.rb with node to allow for hoisting
# require Pod::Executable.execute_command('node', ['-p',
#   'require.resolve(
#     "react-native/scripts/react_native_pods.rb",
#     {paths: [process.argv[1]]},
#   )', __dir__]).strip

  def node_require(script)
    # Resolve script with node to allow for hoisting
    require Pod::Executable.execute_command('node', ['-p',
      "require.resolve(
        '#{script}',
        {paths: [process.argv[1]]},
      )", __dir__]).strip
  end
  
  node_require('react-native/scripts/react_native_pods.rb')
  node_require('react-native-permissions/scripts/setup.rb')

setup_permissions([
  'Camera',
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BachHoaHouston' do
  config = use_native_modules!

rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-maps/Google', :path => rn_maps_path
  # pod 'react-native-maps', :path => rn_maps_path, :subspecs => ['Core', 'GoogleMaps']
  # pod 'GoogleMaps'
  pod 'Google-Maps-iOS-Utils' # x-release-please-version
  pod 'RNInAppBrowser', :path => '../node_modules/react-native-inappbrowser-reborn'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Patch fmt/base.h to disable consteval on all Apple Clang versions (broken in Clang 21 / Xcode 26)
    fmt_base = Dir.glob("#{installer.sandbox.root}/fmt/include/fmt/base.h").first
    if fmt_base && File.exist?(fmt_base)
      content = File.read(fmt_base)
      patched = content.gsub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      File.write(fmt_base, patched) if patched != content
    end
    # Patch StripeSwiftInterop.h: NSUInteger -> NSInteger to match Swift-generated enum type
    stripe_interop = File.join(installer.sandbox.root, '../node_modules/@stripe/stripe-react-native/ios/StripeSwiftInterop.h')
    if File.exist?(stripe_interop)
      content = File.read(stripe_interop)
      patched = content.gsub('typedef NS_ENUM(NSUInteger, STPPaymentStatus);', 'typedef NS_ENUM(NSInteger, STPPaymentStatus);')
      File.write(stripe_interop, patched) if patched != content
    end

    # react_native_post_install only bumps IPHONEOS_DEPLOYMENT_TARGET on each pod's
    # main library target. It skips the resource-bundle targets Cocoapods generates
    # (e.g. *-Bundle, *-PrivacyInfo, *-resources), which are left at whatever old
    # value the pod's podspec hardcodes. Newer Xcode/simulator SDKs no longer support
    # those old values, so force every target in the Pods project up to the same
    # minimum React Native itself requires.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && deployment_target.to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end

      # Silence "will be run during every build because it does not specify any
      # outputs" for Hermes' replace-version script phase — it intentionally has
      # no declared outputs since it conditionally swaps in Debug/Release binaries.
      if target.name == 'hermes-engine'
        target.build_phases.each do |phase|
          if phase.respond_to?(:name) && phase.name && phase.name.include?('Replace Hermes')
            phase.always_out_of_date = '1'
          end
        end
      end
    end
  end
end

target 'OneSignalNotificationServiceExtension' do
  pod 'OneSignalXCFramework', '>= 5.0.0', '< 6.0'
end
